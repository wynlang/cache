fn Cache_new() -> HashMap {
    return HashMap.new()
}

fn Cache_set(cache: HashMap, key: string, value: string) {
    cache.insert(key, value)
}

fn Cache_get(cache: HashMap, key: string) -> string {
    return cache.get(key)
}

fn Cache_has(cache: HashMap, key: string) -> bool {
    var val = cache.get(key)
    return val != ""
}

fn Cache_delete(cache: HashMap, key: string) {
    cache.insert(key, "")
}

fn Cache_size(cache: HashMap) -> int {
    return cache.len()
}

fn main() {
    var c = Cache_new()
    Cache_set(c, "host", "localhost")
    Cache_set(c, "port", "8080")
    println("has host: " + Cache_has(c, "host").to_string())
    println("get host: " + Cache_get(c, "host"))
    println("size: " + Cache_size(c).to_string())
    Cache_delete(c, "host")
    println("after delete, host: " + Cache_get(c, "host"))
}
