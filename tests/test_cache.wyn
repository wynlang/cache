// Exercises the shipped lib in src/cache.wyn via the tests/cache.wyn symlink.
import cache

test "empty get" { assert_eq(cache.cache_get(cache.cache_new(), "x"), "") }
test "set and get" {
    var c = cache.cache_set(cache.cache_new(), "host", "localhost")
    assert_eq(cache.cache_get(c, "host"), "localhost")
}
test "overwrite" {
    var c = cache.cache_set(cache.cache_new(), "k", "v1")
    c = cache.cache_set(c, "k", "v2")
    assert_eq(cache.cache_get(c, "k"), "v2")
}
test "has present" {
    var c = cache.cache_set(cache.cache_new(), "k", "v")
    assert(cache.cache_has(c, "k"))
}
test "has absent" { assert(not cache.cache_has(cache.cache_new(), "k")) }
test "size" {
    var c = cache.cache_set(cache.cache_new(), "a", "1")
    c = cache.cache_set(c, "b", "2")
    assert_eq(cache.cache_size(c), 2)
}
test "overwrite keeps size" {
    var c = cache.cache_set(cache.cache_new(), "a", "1")
    c = cache.cache_set(c, "a", "2")
    assert_eq(cache.cache_size(c), 1)
}
test "delete" {
    var c = cache.cache_set(cache.cache_new(), "x", "y")
    c = cache.cache_delete(c, "x")
    assert(not cache.cache_has(c, "x"))
}
test "value with special chars" {
    var c = cache.cache_set(cache.cache_new(), "url", "http://x.com:8080/a b")
    assert_eq(cache.cache_get(c, "url"), "http://x.com:8080/a b")
}
